# The web app calls the API at same-origin /api (proxied to the server in dev,
# see vite.config.ts). Set this when the API is on another origin, as it is for
# the GitHub Pages build (CI reads the VITE_API_ORIGIN Actions variable) and for
# `npm run dev:remote` (see .env.remote).
# VITE_API_ORIGIN=https://api-replicate-this.keeganvaz.in
