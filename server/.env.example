# --- Server ---
NODE_ENV=development
PORT=8787

# Public URL of the web app (CORS, sign-in, and links in emails)
WEB_ORIGIN=http://localhost:5173
# Optional, comma-separated extra origins trusted for CORS and sign-in.
EXTRA_WEB_ORIGINS=

# --- Database (plain Postgres; docker-compose.yml provides one locally) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/replicate_this

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=generate-a-32-char-random-secret

# --- Peppers (random, secret, stable; EMAIL_PEPPER keys the dummy login email) ---
UID_PEPPER=generate-a-random-uid-pepper
EMAIL_PEPPER=generate-a-random-email-pepper

# --- OAuth providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Slack (community discussion channels) ---
# Bot token of a Slack app installed in the community workspace, with scopes:
# groups:write (create/invite private channels), users:read.email (find members).
# Leave blank to disable the integration entirely.
SLACK_BOT_TOKEN=
# Standing invite link to the workspace (Slack: Invite people > copy link),
# shown to contributors who don't have an account in the workspace yet.
SLACK_INVITE_URL=

# --- Email ---
# Shared inbox that receives admin alerts (milestones, new messages).
ADMIN_EMAIL=admin@forrt.org
# Postmark (EU data region). Leave POSTMARK_API_TOKEN blank to disable email
# (alerts still appear in-app); set it to enable transactional email.
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@forrt.org
