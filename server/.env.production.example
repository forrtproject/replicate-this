# Production values for the aaPanel deployment. Copy to server/.env — dotenv
# reads it from the process working directory, so PM2 must run with cwd=server/.

# --- Server ---
NODE_ENV=production
PORT=8787

# --- Origins ---
# Public URL of the SPA, base path included. CORS and Better Auth compare only
# the origin part of this (a browser's Origin header never carries a path);
# emails link to the whole thing. Get it wrong and the browser blocks every
# request with a CORS error.
WEB_ORIGIN=https://forrt.org/replicate-this
BETTER_AUTH_URL=https://api-replicate-this.keeganvaz.in

# --- Database (PostgreSQL on the same box) ---
# URL-encode the password if it contains @ : / ? # or &.
DATABASE_URL=postgresql://replicate_this:CHANGE_ME@127.0.0.1:5432/replicate_this

# --- Secrets: generate each with `openssl rand -hex 32` ---
# Left unset, the server refuses to start in production rather than fall back to
# the well-known development values.
BETTER_AUTH_SECRET=
# Stable forever — rotating these breaks account linking and orphans users.
UID_PEPPER=
EMAIL_PEPPER=

# --- OAuth providers ---
# Register these redirect URIs with each provider:
#   Google  https://api-replicate-this.keeganvaz.in/api/auth/callback/google
#   GitHub  https://api-replicate-this.keeganvaz.in/api/auth/callback/github
#   ORCID   https://api-replicate-this.keeganvaz.in/api/auth/oauth2/callback/orcid
# An unset id/secret pair simply hides that sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Slack (optional; blank = integration disabled) ---
SLACK_BOT_TOKEN=
SLACK_INVITE_URL=

# --- Email (optional; blank token = email disabled, alerts stay in-app) ---
ADMIN_EMAIL=admin@forrt.org
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@forrt.org
